# ============================================
# LIB_* vendor packages
# Keep only Altium + STEP
# ============================================

/LIB_*/**

# Allow directory traversal
!/LIB_*/**/

# Keep Altium libraries
!/LIB_*/**/*.SchLib
!/LIB_*/**/*.PcbLib
!/LIB_*/**/*.IntLib

# Keep STEP models
!/LIB_*/**/*.STEP
!/LIB_*/**/*.STP
!/LIB_*/**/*.step
